{
  "name": "saywell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent-first translation, English practice, and local typing insights.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build && npm run test:browser",
    "package": "node scripts/package.mjs",
    "preview": "node scripts/preview.mjs",
    "worker:check": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run",
    "worker:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.25.11",
    "fflate": "^0.8.2",
    "jsdom": "^27.0.0",
    "undici": "7.29.1",
    "wrangler": "4.151.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ider-zh/saywell.git"
  },
  "homepage": "https://github.com/ider-zh/saywell#readme",
  "bugs": {
    "url": "https://github.com/ider-zh/saywell/issues"
  }
}
